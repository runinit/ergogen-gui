import assert from 'node:assert/strict';
import { KicadPCB } from './src/kicad/board';
import { getNetNumber } from './src/kicad/common';
globalThis.window = { console } as any;
const wrap = (body: string) => `(kicad_pcb (version 20260206) ${body})`;
const copper = (net: string) => `
 (footprint "x" (layer "F.Cu") (at 0 0) (pad "1" smd rect (at 0 0) (size 1 1) (layers "F.Cu") (net ${net})))
 (segment (start 0 0) (end 1 0) (width 0.2) (layer "F.Cu") (net ${net}))
 (arc (start 0 0) (mid 1 1) (end 2 0) (width 0.2) (layer "F.Cu") (net ${net}))
 (via (at 0 0) (size 0.6) (drill 0.3) (layers "F.Cu" "B.Cu") (net ${net}))
 (zone (net ${net}) (layer "F.Cu"))`;
for (const name of ['GND', '123', '', 'local_1', 'quote"slash\\net']) {
 const pcb = new KicadPCB('test', wrap(copper(JSON.stringify(name))));
 const items = [...pcb.footprints[0]!.pads, ...pcb.segments, ...pcb.vias, ...pcb.zones];
 const net = pcb.nets.find(n => n.name === name);
 assert.ok(net, `missing ${name}`);
 for (const item of items) {
  assert.equal(item.netname, name);
  assert.equal(getNetNumber(item), net.number);
 }
}
const legacy = new KicadPCB('test', wrap('(net 7 "GND")'+copper('7')));
assert.equal(legacy.segments[0]!.netname, 'GND');
const mixed = new KicadPCB('test', wrap('(net 7 "GND")'+copper('7')+copper('"7"')));
assert.notEqual(getNetNumber(mixed.segments[0]!),getNetNumber(mixed.segments[2]!));
for (const bad of ['(kicad_pcb (', '(kicad_pcb (net "unterminated)', wrap('(segment (net 99))')]) {
 assert.throws(() => new KicadPCB('bad',bad));
}
console.log('Net registry checks passed');

import { BoardPainter } from './src/viewers/board/painter';
import { LayerSet } from './src/viewers/board/layers';
import { NullRenderer, NullRenderLayer } from './src/graphics/null-renderer';
import theme from './src/kicanvas/themes/kicad-default';
const highlighted = new KicadPCB('empty-net', wrap(`
 (layers (0 "F.Cu" signal) (2 "B.Cu" signal))
 (segment (start 0 0) (end 1 0) (width 0.2) (layer "F.Cu") (net ""))
 (segment (start 2 0) (end 3 0) (width 0.2) (layer "F.Cu") (net "GND"))`));
const layers = new LayerSet(highlighted, theme.board);
const painter = new BoardPainter(new NullRenderer(), layers, theme.board);
painter.paint_net(highlighted, 0);
assert.equal((layers.overlay.graphics as NullRenderLayer).shapes.length, 1, 'empty net must not highlight all nets');

// Unconnected copper pads have no net label; painting must still finish.
const unconnected = new KicadPCB('unconnected', wrap(`
 (layers (0 "F.Cu" signal) (2 "B.Cu" signal))
 (footprint "switch" (layer "F.Cu") (at 0 0)
  (pad "1" thru_hole circle (at 0 0) (size 2 2) (drill 1) (layers "*.Cu" "*.Mask")))`));
new BoardPainter(new NullRenderer(), new LayerSet(unconnected, theme.board), theme.board).paint(unconnected);
