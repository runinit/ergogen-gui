diff --git a/src/kicad/net-registry.ts b/src/kicad/net-registry.ts
new file mode 100644
index 0000000..4c065fa
--- /dev/null
+++ b/src/kicad/net-registry.ts
@@ -0,0 +1,83 @@
+/* KiCad 10 uses names where older boards use numeric net references. */
+import { listify, type List } from "./tokenizer";
+import type { Parseable } from "./parser";
+
+export function normalize_nets(input: Parseable): List {
+    const parsed = typeof input === "string" ? listify(input) : structuredClone(input);
+    const board = Array.isArray(parsed[0]) && parsed.length === 1 ? parsed[0] : parsed;
+    if (board[0] !== "kicad_pcb") {
+        throw new Error("Expected a KiCad board");
+    }
+    const names = new Map<string, number>([["", 0]]);
+    const numbers = new Map<number, string>([[0, ""]]);
+    const references: { expression: List; parent: List }[] = [];
+    const define = (id: number, name: string) => {
+        if (!Number.isInteger(id) || id < 0 ||
+            (numbers.has(id) && numbers.get(id) !== name) ||
+            (names.has(name) && names.get(name) !== id)) {
+            throw new Error(`Conflicting net ${id}: ${name}`);
+        }
+        numbers.set(id, name);
+        names.set(name, id);
+    };
+    const collect = (parent: List) => {
+        for (const child of parent) {
+            if (!Array.isArray(child)) {
+                continue;
+            }
+            if (child[0] !== "net") {
+                collect(child);
+                continue;
+            }
+            if (child.length < 2 || child.length > 3 ||
+                (typeof child[1] !== "number" && typeof child[1] !== "string")) {
+                throw new Error("Malformed net reference");
+            }
+            if (child.length === 3) {
+                if (typeof child[1] !== "number" || typeof child[2] !== "string") {
+                    throw new Error("Malformed net declaration");
+                }
+                define(child[1], child[2]);
+            }
+            references.push({ expression: child, parent });
+        }
+    };
+    collect(board);
+    let next = Math.max(...numbers.keys()) + 1;
+    for (const { expression, parent } of references) {
+        const reference = expression[1]!;
+        let id: number;
+        let name: string;
+        if (typeof reference === "number") {
+            if (!numbers.has(reference)) {
+                throw new Error(`Unknown net number ${reference}`);
+            }
+            id = reference;
+            name = numbers.get(id)!;
+        } else if (typeof reference === "string") {
+            name = reference;
+            id = names.get(name) ?? next++;
+            define(id, name);
+        } else {
+            throw new Error("Malformed net reference");
+        }
+        // Every copper item receives the same resolved board identity.
+        expression.splice(1, expression.length - 1, id);
+        if (parent === board || parent[0] === "pad") {
+            expression.push(name);
+        }
+        if (parent[0] === "zone") {
+            const label = parent.find((part) => Array.isArray(part) && part[0] === "net_name") as List | undefined;
+            if (label) {
+                label[1] = name;
+            } else {
+                parent.push(["net_name", name]);
+            }
+        }
+    }
+    const result = board.filter((part) => !Array.isArray(part) || part[0] !== "net");
+    for (const [id, name] of numbers) {
+        result.push(["net", id, name]);
+    }
+    return result;
+}
